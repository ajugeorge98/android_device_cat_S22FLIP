# TWRP recovery.fstab for Cat S22 Flip (msm8937)
# Generated for dynamic 'super' layout (system/vendor/product inside super)
# Place into device/cat/S22FLIP/recovery.fstab

# Logical (dynamic) partitions inside super.img
/system     ext4    /dev/block/mapper/system      logical
/vendor     ext4    /dev/block/mapper/vendor      logical
/product    ext4    /dev/block/mapper/product     logical

# Static partitions (by-name)
# boot and recovery — slotselect flagged (A/B aware)
# TWRP will use the by-name nodes to flash or boot images
/boot       emmc    /dev/block/bootdevice/by-name/boot         flags=slotselect
/recovery   emmc    /dev/block/bootdevice/by-name/recovery

# Super (raw) - expose for flashing / backups if needed
/super      emmc    /dev/block/bootdevice/by-name/super

# userdata (f2fs per fastboot), metadata (raw), and cache
/data       f2fs    /dev/block/bootdevice/by-name/userdata     flags=encryptable=footer
/metadata   ext4    /dev/block/bootdevice/by-name/metadata
/cache      ext4    /dev/block/bootdevice/by-name/cache

# Persist (calibration) — mount read-only by default to avoid accidental wipes
/persist    ext4    /dev/block/bootdevice/by-name/persist     flags=ro,display="Persist"

# Device tree / verified boot metadata (not mount points — for flashing operations)
# kept in fstab so TWRP is aware of the nodes and can flash them.
/dtbo       emmc    /dev/block/bootdevice/by-name/dtbo
/vbmeta     emmc    /dev/block/bootdevice/by-name/vbmeta
/vbmetabak  emmc    /dev/block/bootdevice/by-name/vbmetabak
/dtbo_bak   emmc    /dev/block/bootdevice/by-name/dtbobak

# Optional firmware/other (do not mount; for reference/backups)
/modem      emmc    /dev/block/bootdevice/by-name/modem
/dsp        emmc    /dev/block/bootdevice/by-name/dsp

# End of file
