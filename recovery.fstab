# Android fstab file.
#<src>                                      <mnt_point>             <type>  <mnt_flags and options>                     <fs_mgr_flags>

# System partitions (read-only)
/dev/block/bootdevice/by-name/system        /system_root            ext4    ro,barrier=1,discard                        wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
/dev/block/bootdevice/by-name/vendor       /vendor                 ext4    ro,barrier=1,discard                        wait,avb,logical,first_stage_mount
/dev/block/bootdevice/by-name/product      /product                ext4    ro,barrier=1,discard                        wait,avb=vbmeta_system,logical,first_stage_mount

# Critical partitions for TWRP operations
/dev/block/bootdevice/by-name/super        /super                  ext4    rw,barrier=1,discard                        wait,first_stage_mount,formattable,check
/dev/block/bootdevice/by-name/userdata     /data                   f2fs   noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier  latemount,wait,check,formattable,fileencryption=ice,quota,reservedsize=128M,checkpoint=fs,resize

# Essential mounts
/dev/block/bootdevice/by-name/boot         /boot                   emmc    defaults                                    defaults,first_stage_mount
/dev/block/bootdevice/by-name/recovery     /recovery               emmc    defaults                                    defaults,first_stage_mount
/dev/block/bootdevice/by-name/misc         /misc                   emmc    defaults                                    defaults
/dev/block/bootdevice/by-name/metadata     /metadata               ext4    noatime,nosuid,nodev,discard                wait,formattable,first_stage_mount
/dev/block/bootdevice/by-name/persist      /mnt/vendor/persist     ext4    noatime,nosuid,nodev,barrier=1              wait

# Firmware partitions
/dev/block/bootdevice/by-name/modem        /vendor/firmware_mnt    vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait
/dev/block/bootdevice/by-name/dsp          /vendor/dsp             ext4    ro,nosuid,nodev,barrier=1                   wait

# Special TWRP requirements
/dev/block/bootdevice/by-name/cache        /cache                  ext4    noatime,nosuid,nodev,barrier=1              wait,check
/dev/block/bootdevice/by-name/config       /frp                    emmc    defaults                                    defaults
/dev/block/bootdevice/by-name/carrier      /carrier                ext4    rw,seclabel,nosuid,nodev,noatime            defaults

# Removable storage
/dev/block/mmcblk1p1                       /external_sd            auto    defaults                                    voldmanaged=sdcard1:auto,noemulatedsd,encryptable=userdata

/sbin    /sbin    tmpfs    mode=0755,uid=0,gid=0,exec    0 0
