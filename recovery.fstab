# Dynamic partitions
/system     ext4    /dev/block/mapper/system      logical
/vendor     ext4    /dev/block/mapper/vendor      logical
/product    ext4    /dev/block/mapper/product     logical

# Boot and recovery
/boot       emmc    /dev/block/bootdevice/by-name/boot       flags=slotselect
/recovery   emmc    /dev/block/bootdevice/by-name/recovery

# Super partition (for flashing super.img if needed)
/super      emmc    /dev/block/bootdevice/by-name/super

# Data and metadata
/data       f2fs    /dev/block/bootdevice/by-name/userdata    flags=encryptable=footer
/metadata   ext4    /dev/block/bootdevice/by-name/metadata

# Optional cache (legacy)
/cache      ext4    /dev/block/bootdevice/by-name/cache

# Calibration data (read-only)
/persist    ext4    /dev/block/bootdevice/by-name/persist     flags=display="Persist"

# Verified boot metadata (no mount, just for flashing)
/vbmeta     emmc    /dev/block/bootdevice/by-name/vbmeta
/dtbo       emmc    /dev/block/bootdevice/by-name/dtbo
