# recovery.fstab - TWRP-friendly for Cat S22 FLIP
# Format: <blockdev> <mount_point> <fs_type> <mount_flags>

# system / vendor / product (use mapper devices)
/dev/block/mapper/system    /system_root   ext4    ro,wait
/dev/block/mapper/vendor    /vendor        ext4    ro,wait
/dev/block/mapper/product   /product       ext4    ro,wait

# boot / recovery (emmc blocks — adjust if your boot/recovery block differs)
# Replace mmcblk0p51 with actual boot index if needed
/dev/block/mmcblk0p51       /boot          emmc    ro,wait
/dev/block/mmcblk0p52       /recovery      emmc    ro,wait

# userdata / data (fs type may be ext4 or f2fs; change if different)
# TWRP will try to mount /data; leave writable flags for backup operations
/dev/block/mapper/userdata  /data          ext4    nosuid,nodev,noatime

# cache / persist
/dev/block/mmcblk0pNN       /cache         ext4    nosuid,nodev
/dev/block/mmcblk0pMM       /persist       ext4    ro,wait
